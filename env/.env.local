# This file includes environment variables that will be committed to git by default.

# Built-in environment variables
TEAMSFX_ENV=local
APP_NAME_SUFFIX=local
AZURE_TOKEN_CREDENTIALS=dev
CONNECTOR_ID=eiaElectricityConnector
CONNECTOR_NAME=EIA Electricity Connector
CONNECTOR_DESCRIPTION=Indexes EIA electric power operational data including fuel ash content, consumption, and cost metrics by state, sector, and fuel type.

# EIA API configuration
# EIA_API_KEY must be set in env/.env.local.user (never commit your API key)
# Register for a free key at: https://www.eia.gov/opendata/
EIA_START_PERIOD=2020-01

# Generated during provision — do not edit manually, the Toolkit fills these in
# AAD_APP_CLIENT_ID=
# AAD_APP_OBJECT_ID=
# AAD_APP_TENANT_ID=
# AAD_APP_OAUTH_AUTHORITY=
# AAD_APP_OAUTH_AUTHORITY_HOST=